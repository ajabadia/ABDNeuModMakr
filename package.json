{
  "name": "abdneumodmakr",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:types && tsx tests/run_all.ts",
    "test:types": "tsc --noEmit -p tsconfig.json",
    "test:types:all": "tsc --noEmit -p tsconfig.tests.json",
    "lint:security": "node scripts/security-grep.mjs",
    "verify": "npm run test:types && npm run lint:security && tsx tests/run_all.ts",
    "vendor:sync": "node scripts/vendorSync.js"
  },
  "dependencies": {
    "@abdsynths/midi-keyb": "file:./vendor/@abdsynths/midi-keyb",
    "@abdsynths/shared": "file:./vendor/@abdsynths/shared"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
