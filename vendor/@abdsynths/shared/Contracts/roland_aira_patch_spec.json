      "addressBytes": ["aa", "bb", "cc", "dd"]
    },
    "checksum": {
      "algorithm": "Roland 7-bit checksum",
      "scope": "sum of bytes from first address byte through last data byte",
      "formula": "checksum = (0x80 - (sum & 0x7F)) & 0x7F"
    }
