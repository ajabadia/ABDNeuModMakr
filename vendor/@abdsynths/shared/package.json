{
  "name": "@abdsynths/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Núcleo universal transversal para la suite ABDSynths: C++, contratos, componentes WebUI y assets.",
  "exports": {
    "./styles": "./Assets/styles/index.css",
    "./styles/*": "./Assets/styles/*",
    "./themes/*": "./Assets/styles/themes/*",
    "./contracts": {
      "types": "./Contracts/index.d.ts",
      "default": "./Contracts/index.js"
    },
    "./contracts/*": "./Contracts/*",
    "./components": "./Components/index.js",
    "./components/bank/bankShell.js": {
      "types": "./Components/bank/bankShell.d.ts",
      "default": "./Components/bank/bankShell.js"
    },
    "./components/bank/bankCard.js": {
      "types": "./Components/bank/bankCard.d.ts",
      "default": "./Components/bank/bankCard.js"
    },
    "./components/bank/bankChips.js": {
      "types": "./Components/bank/bankChips.d.ts",
      "default": "./Components/bank/bankChips.js"
    },
    "./components/bank/bankCategories.js": {
      "types": "./Components/bank/bankCategories.d.ts",
      "default": "./Components/bank/bankCategories.js"
    },
    "./components/pillSelector.js": {
      "types": "./Components/pillSelector.d.ts",
      "default": "./Components/pillSelector.js"
    },
    "./components/midiLearn.js": {
      "types": "./Components/midiLearn.d.ts",
      "default": "./Components/midiLearn.js"
    },
    "./components/i18n.js": {
      "types": "./Components/i18n.d.ts",
      "default": "./Components/i18n.js"
    },
    "./i18n": {
      "types": "./Components/I18n/index.d.ts",
      "default": "./Components/I18n/index.js"
    },
    "./components/paramGesture.js": {
      "types": "./Components/paramGesture.d.ts",
      "default": "./Components/paramGesture.js"
    },
    "./components/*": "./Components/*",
    "./components/controls/stepMatrix.js": {
      "default": "./Components/Controls/stepMatrix.js"
    },
    "./components/scope/miniWaveScope.js": {
      "default": "./Components/Scope/miniWaveScope.js"
    },
    "./icons/*": "./Assets/icons/*",
    "./assets/*": "./Assets/*",
    "./utils": "./Utils/index.js",
    "./utils/*": "./Utils/*",
    "./visualizers/*": "./Code/visualizers/*",
    "./scope": "./Code/Scope/WebUI/src/scope.js",
    "./scope/*": "./Code/Scope/WebUI/src/*",
    "./formats/neuron": "./Code/NeuronFormats/index.ts",
    "./formats/neuron/*": "./Code/NeuronFormats/*",
    "./formats/sampler": "./Code/SamplerFormats/index.ts",
    "./formats/sampler/*": "./Code/SamplerFormats/*",
    "./dsp/neuron-analysis": "./Code/DspCore/NeuronAnalysis/index.ts",
    "./dsp/neuron-analysis/*": "./Code/DspCore/NeuronAnalysis/*",
    "./dsp/take": "./Code/DspCore/TakeDsp/takeDsp.ts",
    "./dsp/take/*": "./Code/DspCore/TakeDsp/*",
    "./dsp/slicer-loops": "./Code/DspCore/SlicerLoops/index.ts",
    "./dsp/slicer-loops/*": "./Code/DspCore/SlicerLoops/*",
    "./contracts/recordingSession": "./Contracts/recordingSession.ts",
    "./contracts/axionikExpandedModel": "./Contracts/axionikExpandedModel.ts",
    "./ai": "./Code/AiCore/index.ts",
    "./ai/*": "./Code/AiCore/*",
    "./dsp/acoustic-intelligence": "./Code/DspCore/AcousticIntelligence/index.ts",
    "./dsp/acoustic-intelligence/*": "./Code/DspCore/AcousticIntelligence/*",
    "./components/copilot": {
      "types": "./Components/CopilotShell/index.d.ts",
      "default": "./Components/CopilotShell/index.js"
    },
    "./components/copilot/*": "./Components/CopilotShell/*"
  },
  "files": [
    "Code",
    "Contracts",
    "Components",
    "Assets",
    "Utils",
    "docs"
  ]
}
